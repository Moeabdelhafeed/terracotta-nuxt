# Only secrets live here. Everything else is in nuxt.config.ts, committed, so a fresh
# clone runs without this file — copy it to `.env` and fill these two in.
#
# This repository is public: never move these two into nuxt.config.ts.

# Laravel API token. Sent as X-API-TOKEN by the Nitro proxy in server/api/[...].js,
# server-side only — it never reaches the browser bundle.
NUXT_X_API_TOKEN=

# Signs the generated OG images (@nuxtjs/seo).
NUXT_OG_IMAGE_SECRET=

# Optional overrides — nuxt.config.ts already carries working defaults.
# NUXT_API_BASE_URL=https://api.terracotta-ksa.com
# NUXT_PUBLIC_TRANSLATIONS_MODE=local

# Google Maps JavaScript API key — every map on the website. Read at build time (nuxt.config.ts). Restrict it by HTTP referrer in Google Cloud.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=
